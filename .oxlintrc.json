{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "jsx-a11y",
    "nextjs",
    "oxc",
    "react",
    "react-perf",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-restricted-imports": ["error", { "patterns": ["@/tools/*", "**/tools/*"] }]
  },
  "env": {
    "builtin": true
  }
}
